# BACKEND/.env
# -------------
# Local development environment variables.
#
# NEVER commit this file to version control — it is listed in .gitignore.
# Copy .env.example to .env and fill in real values.
# In production set these variables via the hosting platform secrets manager.

# Flask session signing key — must be long, random, and secret in production.
# Generate a new key: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=dev-secret-key-change-in-production

# Set to false in any internet-facing environment.
FLASK_DEBUG=true
