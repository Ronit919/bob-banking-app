# .env.example
# -------------
# Copy this file to .env and fill in your own values before running locally.
# The .env file is listed in .gitignore and must never be committed to source control.
#
# Usage:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows cmd.exe)

# Flask session signing key.
# Generate a secure value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-string

# Debug mode — set to false in any internet-facing environment.
FLASK_DEBUG=true
